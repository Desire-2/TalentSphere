# TalentSphere Backend - Render Deployment Environment Variables
# Set these in your Render service environment variables

# Application Configuration
FLASK_ENV=production
PORT=10000
SECRET_KEY=your-secret-key-here-generate-strong-key
JWT_SECRET_KEY=your-jwt-secret-key-here-generate-strong-key
JWT_REFRESH_GRACE_SECONDS=900
JWT_CLOCK_SKEW_SECONDS=5

# Database Configuration (Render will provide DATABASE_URL automatically)
DATABASE_URL=postgresql://username:password@host:port/database_name
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=1
DB_POOL_TIMEOUT=20
DB_POOL_RECYCLE=300
MAX_WEB_WORKERS=2
# Set DB_POOL_SIZE=1, DB_MAX_OVERFLOW=0, and MAX_WEB_WORKERS=1 for a very small database plan.

# Cache Configuration (Render will provide REDIS_URL automatically)
REDIS_URL=redis://localhost:6379/0

# CORS Configuration (Update with your frontend domains)
# Add all domains that need to access the API (comma-separated, no spaces)
CORS_ORIGINS=https://jobs.afritechbridge.online,https://talentsphere.afritechbridge.online,https://talent-sphere-emmz.vercel.app,https://talentsphere-frontend.vercel.app,https://talentsphere.vercel.app,https://talentsphere-0oh4.onrender.com,https://talentsphere-frontend.onrender.com,http://localhost:5173,http://localhost:5174,http://localhost:3000

# Email Configuration (Brevo Transactional Email)
BREVO_API_KEY=your-brevo-api-v3-key-here
SENDER_EMAIL=your_verified_sender@afritechbridge.online
SENDER_NAME=AfriTech Bridge

# Scheduled Digest Configuration
APP_TIMEZONE=Africa/Kigali
JOB_DIGEST_ENABLED=true
MORNING_JOB_UPDATE_TIME=06:00
WEEKLY_DIGEST_TIME=18:00
ENABLE_CLEANUP_SERVICE=false
# Cleanup runs every 12 hours when enabled; lower this only for controlled testing.
CLEANUP_CHECK_INTERVAL_SECONDS=43200

# Frontend URL for Password Reset Links
FRONTEND_URL=https://jobs.afritechbridge.online

# Comma-separated host allow-list for ad click redirects (ads.py). When set,
# creative cta_url hosts outside this list redirect to / instead. Empty =
# accept stored cta_url (still validated as absolute http(s)).
# AD_REDIRECT_ALLOWED_HOSTS=jobs.afritechbridge.online

# AI API Configuration
SITE_URL=https://jobs.afritechbridge.online
SITE_NAME=AfriTech Opportunities
# Absolute base URL of this API (sandbox checkout links); falls back to
# RENDER_EXTERNAL_URL / request host when unset.
# API_BASE_URL=https://talentsphere-ev6o.onrender.com

# File Storage (Vercel Blob)
VERCEL_BLOB_READ_WRITE_TOKEN=your-vercel-blob-read-write-token-here

# Performance Configuration
SLOW_QUERY_THRESHOLD=1.0
SLOW_REQUEST_THRESHOLD=2.0
ENABLE_PERFORMANCE_MONITORING=true
WARM_CACHE_ON_STARTUP=false
INIT_DB_ON_STARTUP=true

# Security Settings
BCRYPT_LOG_ROUNDS=12
PASSWORD_RESET_EXPIRE_HOURS=1
JWT_ACCESS_TOKEN_EXPIRES=3600

# Optimization Settings
CACHE_TTL_SHORT=300
CACHE_TTL_MEDIUM=1800
CACHE_TTL_LONG=3600

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Render-specific optimizations
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
GUNICORN_CMD_ARGS="--config gunicorn.conf.py"

# ── AI Career Agent (NVIDIA inference) ─────────────────────────────
# Server-side only; never expose to the frontend.
NVIDIA_API_KEY=
# Text model is fixed to nvidia/nemotron-3.5-lightning-30b-a3b for all text work.
# Text requests always use the requested provider profile: streaming against
# the NVIDIA chat-completions endpoint. Token budgets and temperature are
# bounded by default (max_tokens=8192, temperature=0.2, reasoning_budget=2048,
# thinking disabled) because NVIDIA's endpoint is far slower when thinking and
# a maximum 16384-token budget are requested. All values are overridable per
# environment.
# Vision model used for image extraction (default: nvidia/nemotron-3-nano-omni-30b-a3b-reasoning)
# NVIDIA_VISION_MODEL=
# Enabling thinking is slow (one structured call can take >2 minutes at the
# maximum budget). Keep it off for the JSON pipeline unless quality testing
# shows it helps your prompts.
# NVIDIA_ENABLE_THINKING=false
# NVIDIA_MAX_TOKENS=8192
# NVIDIA_REASONING_BUDGET=
# NVIDIA_TEMPERATURE=0.2
# Seconds the client may wait through provider rate limits (default 120)
# NVIDIA_RATE_LIMIT_MAX_WAIT_SECONDS=
# Seconds the client may wait through transient provider 5xx responses (default 30)
# NVIDIA_TRANSIENT_MAX_WAIT_SECONDS=
# Package-level auto-retry for transient provider failures. The retry resumes
# at the failed stage, so the base delay only has to cover that one stage.
# CAREER_AGENT_AUTO_RETRY_LIMIT=2
# CAREER_AGENT_AUTO_RETRY_BASE_SECONDS=15
# CAREER_AGENT_AUTO_RETRY_MAX_SECONDS=90
# "Refining the writing" is cosmetic: these bound that stage so it can never
# outlive the stages that actually authored the documents.
# CAREER_AGENT_HUMANIZE_TIMEOUT_SECONDS=45
# CAREER_AGENT_HUMANIZE_MAX_TOKENS=3072
# CAREER_AGENT_HUMANIZE_RETRIES=1
# CAREER_AGENT_WORKER_POLL_SECONDS=5
# CAREER_AGENT_STALE_AFTER_SECONDS=900

# ── Career Agent payments ─────────────────────────────────────────
# sandbox    = local hosted checkout with Simulate success/failure (now)
# configured_http = real provider adapter (set CREATE/VERIFY/API keys later)
CAREER_PAYMENT_PROVIDER=sandbox
CAREER_PAYMENT_CREATE_URL=
CAREER_PAYMENT_VERIFY_URL=
CAREER_PAYMENT_API_KEY=
# Random secret; also used to sign ad-credit checkout links.
CAREER_PAYMENT_WEBHOOK_SECRET=
# Ad credit packs (RWF) purchasable while in sandbox mode.
# Pools are defined in backend/src/routes/ads.py (AD_CREDIT_PACKAGES).
# Use a mounted persistent volume in production.
CAREER_AGENT_STORAGE_DIR=/app/private_career_files
