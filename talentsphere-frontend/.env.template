# Copy to .env and fill in values. VITE_ vars are embedded at build time —
# production builds need the production values set in the deploy environment
# (Cloudflare Pages / Vercel project settings), not in this file.

# API
# Local dev: /api (vite proxy). Production build: full Render API URL.
VITE_API_BASE_URL=/api
# Production example:
# VITE_API_BASE_URL=https://talentsphere-ev6o.onrender.com/api
VITE_API_URL=http://localhost:5000
VITE_API_TIMEOUT=30000

# Site
VITE_APP_NAME=AfriTech Opportunities
VITE_APP_ENVIRONMENT=development
VITE_APP_URL=http://localhost:5173
VITE_FRONTEND_URL=http://localhost:5173
VITE_SUPPORT_EMAIL=support@afritechbridge.online
VITE_CONTACT_EMAIL=support@afritechbridge.online
VITE_NOREPLY_EMAIL=noreply@afritechbridge.online

# Google AdSense (ad units are created in the AdSense console; paste slot IDs below)
VITE_GOOGLE_ADS_CLIENT_ID=ca-pub-2776294322568123
VITE_AD_SLOT_BANNER=
VITE_AD_SLOT_SQUARE=
VITE_AD_SLOT_RESPONSIVE=
